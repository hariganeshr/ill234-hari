---
interface Props {
    departments: string[];
    locations: string[];
}

const { departments, locations } = Astro.props;
const selectClass =
    'w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-[#2E6CFC] focus:border-[#2E6CFC]';
---

<form
  class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end"
  data-testid="role-filters"
  onsubmit="return false"
>
  <div class="flex-1">
    <label for="department-filter" class="mb-1 block text-sm font-medium text-slate-300">Department</label>
    <select id="department-filter" name="department" class={selectClass} data-testid="department-filter">
      <option value="">All departments</option>
      {departments.map((department) => <option value={department}>{department}</option>)}
    </select>
  </div>
  <div class="flex-1">
    <label for="location-filter" class="mb-1 block text-sm font-medium text-slate-300">Location</label>
    <select id="location-filter" name="location" class={selectClass} data-testid="location-filter">
      <option value="">All locations</option>
      {locations.map((location) => <option value={location}>{location}</option>)}
    </select>
  </div>
  <button
    type="button"
    class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-100 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-[#2E6CFC]"
    data-testid="filters-reset"
  >
    Reset filters
  </button>
</form>
